IAMLLM_ENV=production
IAMLLM_BIND_IP=0.0.0.0
IAMLLM_PORT=8000
IAMLLM_DATABASE_PATH=/data/iamllm.db

# 分别运行 openssl rand -hex 32 生成，不要复用。
IAMLLM_API_KEY=sk-REPLACE_WITH_A_LONG_RANDOM_VALUE
IAMLLM_ADMIN_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE
IAMLLM_ADMIN_USERNAME=admin
IAMLLM_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
IAMLLM_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_CHARACTERS

IAMLLM_MODEL_NAME=iam-your-name
IAMLLM_PUBLIC_BASE_URL=https://human.example.com
IAMLLM_TIMEZONE=UTC

IAMLLM_RESPONSE_TIMEOUT_SECONDS=300
IAMLLM_STREAM_IDLE_TIMEOUT_SECONDS=120
IAMLLM_JOB_TTL_SECONDS=86400
IAMLLM_POLL_INTERVAL_MS=100
IAMLLM_TIMEOUT_FALLBACK_TEXTS=【超时兜底】我知道你很急，但你先别急。稍后再戳我一次。||【超时兜底】请求已送达人类大脑，可惜大脑暂未签收。||【超时兜底】这次不是网络延迟，是肉身延迟。稍后再来。
IAMLLM_STREAM_CHUNK_DELAY_MS=10
IAMLLM_STREAM_CHUNK_CHARS=3
IAMLLM_NOTIFICATION_WEBHOOK_URL=
IAMLLM_NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5
