IAMLLM_ENV_FILE=.env.production
IAMLLM_ENV=production

# 用 openssl rand -hex 32 分别生成；不要复用这三个值。
IAMLLM_API_KEY=REPLACE_ME
IAMLLM_ADMIN_USERNAME=admin
IAMLLM_ADMIN_PASSWORD=REPLACE_ME
IAMLLM_SESSION_SECRET=REPLACE_ME

IAMLLM_MODEL_NAME=iam-your-name
IAMLLM_PUBLIC_BASE_URL=https://human.example.com
IAMLLM_COOKIE_SECURE=true
IAMLLM_TIMEZONE=Asia/Shanghai

# 可选；Render 等无持久磁盘的平台必须填写 PostgreSQL/Supabase 连接串。
IAMLLM_DATABASE_URL=

IAMLLM_RESPONSE_TIMEOUT_SECONDS=300
IAMLLM_STREAM_IDLE_TIMEOUT_SECONDS=120
IAMLLM_JOB_TTL_SECONDS=86400
IAMLLM_TIMEOUT_FALLBACK_TEXTS=【超时兜底】我知道你很急，但你先别急。稍后再戳我一次。||【超时兜底】请求已送达人类大脑，可惜大脑暂未签收。||【超时兜底】这次不是网络延迟，是肉身延迟。稍后再来。
IAMLLM_STREAM_CHUNK_DELAY_MS=45
IAMLLM_STREAM_CHUNK_CHARS=12
IAMLLM_STREAM_KEEPALIVE_SECONDS=10
IAMLLM_MAX_UPLOAD_BYTES=8388608

# 可选。收到新问题时会 POST 通用 JSON；留空即关闭。
IAMLLM_NOTIFICATION_WEBHOOK_URL=
IAMLLM_NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5

# 默认仅监听本机，建议让 Caddy/Nginx/云平台负责公网 HTTPS。
IAMLLM_BIND_IP=127.0.0.1
IAMLLM_PORT=8000
